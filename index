    <script>
      (() => {
        const INLINE_ASSETS = {"titleBanner":"data:image/png;base64,","arena":"data:image/png;base64,","player":"data:image/png;base64,","monster":"data:image/png;base64,","playerVictory":"data:image/png;base64,","monsterDefeat":"data:image/png;base64,","playerDefeat":"data:image/png;base64,","stage2Player":"data:image/png;base64,","stage2Monster":"data:image/png;base64,","stage2PlayerVictory":"data:image/png;base64,","stage2MonsterDefeat":"data:image/png;base64,","stage2PlayerDefeat":"data:image/png;base64,","stage3Monster":"data:image/png;base64,","stage4Monster":"data:image/png;base64,","stage5Monster":"data:image/png;base64,","stage6Monster":"data:image/png;base64,","stage7Monster":"data:image/png;base64,","stage8Monster":"data:image/png;base64,","stage3MonsterDefeat":"data:image/png;base64,","stage4MonsterDefeat":"data:image/png;base64,","stage5MonsterDefeat":"data:image/png;base64,","stage6MonsterDefeat":"data:image/png;base64,","stage7MonsterDefeat":"data:image/png;base64,","stage8MonsterDefeat":"data:image/png;base64,"};
