        class AudioEngine {
          constructor() {
            this.context = null;
            this.master = null;
            this.enabled = false;
            this.musicTimer = null;
          }

          async setEnabled(enabled) {
            if (!enabled) {
              this.enabled = false;
              clearTimeout(this.musicTimer);
              this.musicTimer = null;
              return false;
            }
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return false;
            if (!this.context) {
              this.context = new AudioContext();
              this.master = this.context.createGain();
              this.master.gain.value = .18;
              this.master.connect(this.context.destination);
            }
            await this.context.resume();
            this.enabled = true;
            this.startMusic();
            return true;
          }

          tone(frequency, duration, start, type = 'triangle', volume = .12) {
            if (!this.context || !this.master) return;
            const oscillator = this.context.createOscillator();
            const gain = this.context.createGain();
            oscillator.type = type;
            oscillator.frequency.setValueAtTime(frequency, start);
            gain.gain.setValueAtTime(.0001, start);
            gain.gain.exponentialRampToValueAtTime(volume, start + .012);
            gain.gain.exponentialRampToValueAtTime(.0001, start + duration);
            oscillator.connect(gain);
            gain.connect(this.master);
            oscillator.start(start);
            oscillator.stop(start + duration + .02);
          }

          startMusic() {
            clearTimeout(this.musicTimer);
            const playBar = () => {
              if (!this.enabled || !this.context) return;
              const start = this.context.currentTime + .04;
              const melody = [392, 0, 440, 494, 523, 494, 440, 392, 349, 392, 440, 349];
              melody.forEach((note, index) => {
                if (note) this.tone(note, .16, start + index * .13, 'square', .052);
              });
              [98, 98, 110, 123].forEach((note, index) => {
                this.tone(note, .38, start + index * .39, 'triangle', .075);
              });
              this.musicTimer = setTimeout(playBar, 1560);
            };
            playBar();
          }

          playSelect() {
            if (!this.enabled || !this.context) return;
            const start = this.context.currentTime;
            this.tone(523, .08, start, 'square', .07);
            this.tone(784, .13, start + .07, 'square', .065);
          }

          playCorrect() {
            if (!this.enabled || !this.context) return;
            const start = this.context.currentTime;
            this.tone(180, .07, start, 'sawtooth', .11);
            this.tone(340, .11, start + .045, 'square', .08);
            this.tone(680, .14, start + .085, 'triangle', .065);
          }

          playDamage() {
            if (!this.enabled || !this.context) return;
            const start = this.context.currentTime;
            this.tone(170, .2, start, 'sawtooth', .12);
            this.tone(92, .28, start + .04, 'sawtooth', .1);
          }

          playClear() {
            if (!this.enabled || !this.context) return;
            const start = this.context.currentTime;
            [523, 659, 784, 1047].forEach((note, index) => this.tone(note, .24, start + index * .12, 'triangle', .09));
          }
        }
        const audio = new AudioEngine();
        const els = {
