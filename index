<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#071126" />
    <meta
      name="description"
      content="10秒で答える、ステージ式の格闘ゲーム風かけ算練習アプリ"
    />
    <title>九九ファイト！</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Noto+Sans+JP:wght@500;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23071126'/%3E%3Cpath d='M12 38 29 13l23 13-11 25-15-5-14 6Z' fill='%23ffd54a'/%3E%3Cpath d='M17 38h30' stroke='%2300e5ff' stroke-width='5' stroke-linecap='round'/%3E%3C/svg%3E"
    />
    <style>
      :root {
        --ink: #f7f9ff;
        --navy: #071126;
        --navy-2: #101e43;
        --cyan: #20e2ff;
        --pink: #ff4fa3;
        --gold: #ffd54a;
        --danger: #ff5f65;
        --muted: #b4c3e8;
      }

      * { box-sizing: border-box; }
      html { background: var(--navy); }
      body {
        min-width: 320px;
        min-height: 100vh;
        margin: 0;
        color: var(--ink);
        font-family: "Noto Sans JP", system-ui, sans-serif;
        background:
          radial-gradient(circle at 50% -20%, #293b8c 0, transparent 42%),
          linear-gradient(135deg, #071126 0%, #11113f 50%, #071126 100%);
      }

      button { font: inherit; }
      button:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }

      .game-shell {
        width: min(1120px, calc(100% - 28px));
        min-height: 100vh;
        margin: auto;
        padding: 22px 0 30px;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 17px;
        padding-right: 94px;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: "Black Han Sans", "Noto Sans JP", sans-serif;
        font-size: clamp(1.45rem, 3vw, 2.15rem);
        font-style: italic;
        letter-spacing: .04em;
        line-height: 1;
        text-shadow: 3px 3px 0 #263b8f;
      }
      .brand-burst {
        display: grid;
        width: 38px;
        height: 38px;
        place-items: center;
        color: #071126;
        background: var(--gold);
        clip-path: polygon(50% 0, 61% 33%, 94% 13%, 73% 45%, 100% 50%, 73% 57%, 93% 87%, 61% 67%, 50% 100%, 39% 67%, 7% 87%, 27% 57%, 0 50%, 27% 44%, 7% 13%, 39% 33%);
        font-size: 1.1rem;
      }
      .round-label {
        padding: 7px 12px;
        border: 1px solid rgba(32, 226, 255, .55);
        border-radius: 999px;
        color: var(--cyan);
        background: rgba(7, 17, 38, .7);
        font-size: .88rem;
        font-weight: 900;
      }

      .arena {
        position: relative;
        overflow: hidden;
        isolation: isolate;
        min-height: 760px;
        border: 2px solid rgba(123, 191, 255, .62);
        border-radius: 24px;
        background: #071126;
        box-shadow: 0 0 0 5px rgba(32,226,255,.08), 0 22px 60px rgba(0,0,0,.44), inset 0 0 70px rgba(0,0,0,.58);
      }
      .arena::after {
        position: absolute;
        z-index: 2;
        inset: 0;
        content: "";
        pointer-events: none;
        background: linear-gradient(180deg, rgba(5, 10, 30, .12) 29%, rgba(6, 7, 22, .02) 45%, rgba(2, 5, 20, .75) 100%);
      }
      .arena-background {
        position: absolute;
        z-index: 0;
        inset: 0;
        background: var(--inline-arena-background, #071126) 50% 50% / cover no-repeat;
      }
      .fighter-stage {
        position: absolute;
        z-index: 1;
        top: 128px;
        right: 0;
        left: 0;
        height: 222px;
        pointer-events: none;
      }
      .fighter-sprite {
        position: absolute;
        top: auto;
        bottom: 0;
        display: block;
        max-width: 46%;
        height: 100%;
        object-fit: contain;
        object-position: bottom center;
        filter: drop-shadow(0 13px 13px rgba(0, 0, 0, .38));
        transform: translate3d(0, 0, 0);
        transform-origin: 50% 80%;
        will-change: transform, filter;
      }
      .fighter-sprite.player { left: 5%; height: 80%; }
      .fighter-sprite.monster { right: 4%; height: 150%; }
      .scanlines {
        position: absolute;
        z-index: 3;
        inset: 0;
        pointer-events: none;
        opacity: .12;
        background: repeating-linear-gradient(0deg, transparent 0 3px, #94edff 3px 4px);
        mix-blend-mode: overlay;
      }

      .fighter-name {
        position: absolute;
        z-index: 4;
        top: 22px;
        max-width: 40%;
        font-size: clamp(.8rem, 2vw, 1.05rem);
        font-weight: 900;
        letter-spacing: .07em;
        text-shadow: 2px 2px 0 #071126;
      }
      .fighter-name.player { left: 24px; color: var(--cyan); }
      .fighter-name.enemy { right: 24px; color: var(--pink); text-align: right; }
      .health {
        position: absolute;
        z-index: 4;
        top: 51px;
        width: min(280px, 30%);
        height: 14px;
        overflow: hidden;
        border: 2px solid rgba(255,255,255,.8);
        border-radius: 3px;
        background: rgba(5,8,21,.8);
        box-shadow: 0 2px 0 rgba(0,0,0,.45);
      }
      .health.player { left: 24px; }
      .health.enemy { right: 24px; transform: scaleX(-1); }
      .health > span {
        display: block;
        width: 100%;
        height: 100%;
        transform-origin: left;
        background: linear-gradient(90deg, #ffe45e, #ff8465 58%, #ff4fa3);
        transition: width .28s ease;
      }

      .math-zone {
        position: relative;
        z-index: 5;
        display: grid;
        justify-items: center;
        width: min(510px, calc(100% - 30px));
        margin: 355px auto 0;
        text-align: center;
      }
      .timer-head {
        display: flex;
        width: 100%;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 0 2px 7px;
        font-size: .86rem;
        font-weight: 900;
        letter-spacing: .09em;
        text-shadow: 1px 1px 0 #071126;
      }
      .timer-readout { color: var(--gold); font-variant-numeric: tabular-nums; }
      .timer-track {
        width: 100%;
        height: 13px;
        overflow: hidden;
        border: 2px solid rgba(255,255,255,.85);
        border-radius: 999px;
        background: rgba(6, 10, 30, .85);
        box-shadow: 0 3px 0 rgba(0,0,0,.35);
      }
      .timer-fill {
        width: 100%;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, var(--cyan), #b8fcff 52%, var(--gold));
        transform-origin: left;
      }
      .timer-fill.rush { background: linear-gradient(90deg, var(--pink), var(--danger)); }
      .question-card {
        width: 100%;
        margin-top: 10px;
        padding: 15px 18px 17px;
        border: 2px solid rgba(255,255,255,.92);
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(6, 19, 50, .94), rgba(21, 30, 79, .88));
        box-shadow: 6px 6px 0 rgba(2, 5, 19, .6), inset 0 0 25px rgba(32,226,255,.08);
      }
      .prompt { color: var(--muted); font-size: .82rem; font-weight: 800; letter-spacing: .16em; }
      .question {
        margin: 2px 0 -5px;
        color: #fff;
        font-family: "Black Han Sans", "Noto Sans JP", sans-serif;
        font-size: clamp(3.3rem, 9vw, 5.6rem);
        font-style: italic;
        line-height: 1.05;
        letter-spacing: .04em;
        text-shadow: 4px 4px 0 #152b70, 7px 7px 0 rgba(0,0,0,.28);
      }

      .answers {
        position: relative;
        z-index: 5;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
        width: min(500px, calc(100% - 36px));
        margin: 17px auto 0;
      }
      .answer {
        position: relative;
        min-height: 92px;
        overflow: hidden;
        border: 2px solid rgba(255,255,255,.85);
        border-radius: 13px;
        color: #071126;
        background: linear-gradient(135deg, #eefeff, #54e7ff);
        box-shadow: 5px 5px 0 #06112b, inset 0 -6px 0 rgba(0,97,144,.25);
        cursor: pointer;
        font-family: "Black Han Sans", "Noto Sans JP", sans-serif;
        font-size: clamp(2.2rem, 6vw, 3.35rem);
        font-style: italic;
        line-height: 1;
        transition: transform .12s ease, filter .12s ease;
      }
      .answer:nth-child(2) { background: linear-gradient(135deg, #fff5fb, #ff80bc); }
      .answer:hover:not(:disabled) { transform: translate(-2px, -3px); filter: brightness(1.1); }
      .answer:active:not(:disabled) { transform: translate(3px, 3px); box-shadow: 2px 2px 0 #06112b, inset 0 -3px 0 rgba(0,97,144,.25); }
      .answer:disabled { cursor: default; }
      .keycap {
        position: absolute;
        top: 8px;
        left: 9px;
        padding: 2px 6px;
        border: 1px solid rgba(7,17,38,.45);
        border-radius: 4px;
        font-family: "Noto Sans JP", sans-serif;
        font-size: .67rem;
        font-style: normal;
        font-weight: 900;
      }

      .battle-copy {
        position: relative;
        z-index: 5;
        min-height: 38px;
        margin: 12px auto 0;
        padding: 0 16px;
        color: #fff;
        text-align: center;
        font-size: clamp(.9rem, 2.3vw, 1.1rem);
        font-weight: 900;
        text-shadow: 2px 2px 0 #071126;
      }
      .impact-word {
        position: absolute;
        z-index: 6;
        top: 49%;
        left: 50%;
        display: none;
        margin: 0;
        color: #fff;
        font-family: "Black Han Sans", "Noto Sans JP", sans-serif;
        font-size: clamp(3.3rem, 11vw, 8.5rem);
        font-style: italic;
        letter-spacing: .03em;
        line-height: 1;
        pointer-events: none;
        text-shadow: 5px 5px 0 #ff4fa3, 10px 10px 0 #101e43;
        transform: translate(-50%, -50%) rotate(-8deg) scale(.5);
      }
      .arena.attack .impact-word,
      .arena.damage .impact-word { display: block; animation: impact .64s ease-out both; }
      .arena.attack .player-sprite { animation: player-attack .72s cubic-bezier(.18,.72,.27,1) both; }
      .arena.attack .monster-sprite { animation: monster-hit .62s ease-out both; }
      .arena.damage .monster-sprite { animation: monster-attack .72s cubic-bezier(.18,.72,.27,1) both; }
      .arena.damage .player-sprite { animation: player-hit .62s ease-out both; }
      .arena.damage { animation: screen-shake .42s linear; }
      .arena.ko .impact-word { display: block; color: var(--gold); text-shadow: 5px 5px 0 #ff4fa3, 10px 10px 0 #071126; animation: ko .8s cubic-bezier(.12,.72,.22,1) both; }
      .arena.player-wins .start-layer,
      .arena.player-loses .start-layer { background: radial-gradient(circle at 50% 42%, rgba(25,50,119,.13), rgba(4,9,28,.67) 72%); }
      .arena.player-wins .player-sprite { animation: player-victory .8s cubic-bezier(.18,.82,.28,1) both; }
      .arena.player-wins .monster-sprite { animation: monster-defeat-fade 2.3s ease-in-out both; }
      .arena.player-loses .player-sprite { animation: player-defeat-entry .72s cubic-bezier(.2,.78,.34,1) both; }

      .rules {
        display: flex;
        justify-content: center;
        gap: 12px 24px;
        flex-wrap: wrap;
        margin: 17px 0 0;
        color: var(--muted);
        font-size: .84rem;
        font-weight: 700;
      }
      .rule-dot { color: var(--gold); }

      .start-layer {
        position: absolute;
        z-index: 10;
        inset: 0;
        display: grid;
        place-items: center;
        padding: 24px;
        background: radial-gradient(circle at 50% 42%, rgba(25,50,119,.18), rgba(4,9,28,.86) 72%);
        text-align: center;
        transition: opacity .3s ease, visibility .3s ease;
      }
      .start-layer.hidden { visibility: hidden; opacity: 0; pointer-events: none; }
      .start-panel { max-width: 430px; }
      .vs { margin: 0; color: var(--pink); font-family: "Black Han Sans", sans-serif; font-size: 2rem; font-style: italic; text-shadow: 3px 3px 0 #071126; }
      .start-title { margin: 0 0 10px; font-family: "Black Han Sans", "Noto Sans JP", sans-serif; font-size: clamp(3rem, 10vw, 5.3rem); font-style: italic; line-height: .95; text-shadow: 4px 4px 0 #243d97, 8px 8px 0 rgba(0,0,0,.45); }
      .start-panel p { margin: 18px 0; color: #dce9ff; font-weight: 800; line-height: 1.8; }
      .start-button, .restart-button, .next-stage-button {
        border: 2px solid #fff;
        border-radius: 10px;
        padding: 14px 28px;
        color: #071126;
        background: var(--gold);
        box-shadow: 5px 5px 0 #ff4fa3;
        cursor: pointer;
        font-family: "Black Han Sans", "Noto Sans JP", sans-serif;
        font-size: 1.35rem;
        font-style: italic;
        letter-spacing: .04em;
        transition: transform .13s ease;
      }
      .start-button:hover, .restart-button:hover, .next-stage-button:hover { transform: translate(-2px, -2px); }
      .result-panel { display: none; }
      .result-panel.show { display: block; }
      .result-panel h2 { margin: 0; color: var(--gold); font-family: "Black Han Sans", "Noto Sans JP", sans-serif; font-size: clamp(2.7rem, 8vw, 4.4rem); font-style: italic; text-shadow: 4px 4px 0 #ff4fa3; }
      .result-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px; margin-top: 20px; }
      .restart-button { margin: 0; background: var(--cyan); box-shadow: 5px 5px 0 #175b88; }
      .next-stage-button { background: var(--gold); }

      @keyframes impact {
        0% { opacity: 0; transform: translate(-50%, -50%) rotate(-15deg) scale(.3); }
        35% { opacity: 1; transform: translate(-50%, -50%) rotate(-8deg) scale(1.18); }
        100% { opacity: 0; transform: translate(-50%, -50%) rotate(-4deg) scale(1.45); }
      }
      @keyframes ko {
        0% { opacity: 0; transform: translate(-50%, -50%) rotate(-14deg) scale(.2); }
        48% { opacity: 1; transform: translate(-50%, -50%) rotate(-8deg) scale(1.15); }
        100% { opacity: 1; transform: translate(-50%, -50%) rotate(-8deg) scale(1); }
      }
      @keyframes screen-shake {
        0%, 100% { transform: translateX(0); }
        20% { transform: translateX(-11px) rotate(-.3deg); }
        40% { transform: translateX(10px) rotate(.25deg); }
        60% { transform: translateX(-6px); }
        80% { transform: translateX(5px); }
      }
      @keyframes player-attack {
        0% { transform: translate3d(0, 0, 0) scale(1); filter: drop-shadow(0 13px 13px rgba(0, 0, 0, .38)); }
        42% { transform: translate3d(59%, -5%, 0) scale(1.08); filter: brightness(1.23) saturate(1.5) drop-shadow(0 13px 18px rgba(32, 226, 255, .55)); }
        100% { transform: translate3d(0, 0, 0) scale(1); filter: drop-shadow(0 13px 13px rgba(0, 0, 0, .38)); }
      }
      @keyframes monster-hit {
        0%, 35% { transform: translate3d(0, 0, 0); }
        52% { transform: translate3d(7%, 1%, 0) rotate(2deg); filter: brightness(1.8) drop-shadow(0 13px 18px rgba(255, 79, 163, .7)); }
        100% { transform: translate3d(0, 0, 0); }
      }
      @keyframes monster-attack {
        0% { transform: translate3d(0, 0, 0) scale(1); filter: drop-shadow(0 13px 13px rgba(0, 0, 0, .38)); }
        42% { transform: translate3d(-58%, -5%, 0) scale(1.08); filter: brightness(1.18) saturate(1.45) drop-shadow(0 13px 18px rgba(255, 79, 163, .6)); }
        100% { transform: translate3d(0, 0, 0) scale(1); filter: drop-shadow(0 13px 13px rgba(0, 0, 0, .38)); }
      }
      @keyframes player-hit {
        0%, 35% { transform: translate3d(0, 0, 0); }
        52% { transform: translate3d(-7%, 1%, 0) rotate(-2deg); filter: brightness(1.8) drop-shadow(0 13px 18px rgba(32, 226, 255, .7)); }
        100% { transform: translate3d(0, 0, 0); }
      }
      @keyframes player-victory {
        0% { opacity: 0; transform: translate3d(-14%, 14%, 0) scale(.74); filter: brightness(1.35) drop-shadow(0 13px 18px rgba(32, 226, 255, .72)); }
        62% { opacity: 1; transform: translate3d(2%, -4%, 0) scale(1.1); filter: brightness(1.18) drop-shadow(0 13px 22px rgba(32, 226, 255, .8)); }
        100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); filter: drop-shadow(0 13px 13px rgba(0, 0, 0, .38)); }
      }
      @keyframes player-defeat-entry {
        0% { opacity: 0; transform: translate3d(-5%, -10%, 0) scale(1.08); filter: brightness(1.45) saturate(.8) drop-shadow(0 13px 18px rgba(32, 226, 255, .58)); }
        100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); filter: grayscale(.28) brightness(.76) drop-shadow(0 13px 13px rgba(0, 0, 0, .38)); }
      }
      @keyframes monster-defeat-fade {
        0%, 9% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); filter: drop-shadow(0 13px 13px rgba(0, 0, 0, .38)); }
        17% { opacity: 1; transform: translate3d(1%, 0, 0) scale(1.03); filter: brightness(1.65) saturate(2.2) sepia(.45) hue-rotate(308deg) drop-shadow(0 0 22px rgba(255, 56, 70, .96)); }
        26% { opacity: .9; transform: translate3d(-1%, 1%, 0) scale(.99); filter: brightness(.84) saturate(.75) drop-shadow(0 13px 13px rgba(0, 0, 0, .38)); }
        36% { opacity: .88; transform: translate3d(1%, 1%, 0) scale(1); filter: brightness(1.72) saturate(2.4) sepia(.55) hue-rotate(308deg) drop-shadow(0 0 24px rgba(255, 56, 70, 1)); }
        58% { opacity: .52; transform: translate3d(-2%, 5%, 0) scale(.96); filter: brightness(.78) saturate(.52) drop-shadow(0 6px 12px rgba(255, 56, 70, .45)); }
        100% { opacity: .3; transform: translate3d(0, 6%, 0) scale(.93); filter: grayscale(.28) brightness(.72) saturate(.55) drop-shadow(0 7px 12px rgba(255, 56, 70, .38)); }
      }

      .title-screen {
        width: min(1120px, calc(100% - 28px));
        min-height: 100vh;
        margin: auto;
        padding: 22px 0 34px;
      }
      .title-hero {
        position: relative;
        min-height: 310px;
        overflow: hidden;
        border: 2px solid rgba(123, 191, 255, .72);
        border-radius: 26px;
        background: #071126;
        box-shadow: 0 0 0 5px rgba(32,226,255,.08), 0 24px 60px rgba(0,0,0,.45);
      }
      .title-hero-art {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 14%;
        opacity: .9;
      }
      .title-hero::after {
        position: absolute;
        inset: 0;
        content: "";
        background: linear-gradient(90deg, rgba(4, 8, 29, .78), rgba(4, 8, 29, .12) 54%, rgba(4, 8, 29, .66)), linear-gradient(0deg, rgba(3, 7, 24, .72), transparent 54%);
      }
      .title-copy {
        position: relative;
        z-index: 1;
        display: grid;
        align-content: end;
        min-height: 310px;
        padding: 28px clamp(20px, 5vw, 58px);
      }
      .title-kicker {
        margin: 0 0 5px;
        color: var(--cyan);
        font-size: clamp(.76rem, 1.6vw, .95rem);
        font-weight: 900;
        letter-spacing: .18em;
      }
      .title-heading {
        margin: 0;
        font-family: "Black Han Sans", "Noto Sans JP", sans-serif;
        font-size: clamp(2.45rem, 8vw, 5.7rem);
        font-style: italic;
        letter-spacing: .02em;
        line-height: .95;
        text-shadow: 5px 5px 0 #101e73, 0 0 22px rgba(32,226,255,.5);
      }
      .title-copy p:last-child {
        max-width: 37rem;
        margin: 14px 0 0;
        font-size: clamp(.9rem, 2vw, 1.05rem);
        font-weight: 800;
      }
      .stage-select-panel { margin-top: 23px; }
      .stage-select-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 15px;
        margin: 0 0 13px;
      }
      .stage-select-heading h2 {
        margin: 0;
        color: var(--gold);
        font-family: "Black Han Sans", "Noto Sans JP", sans-serif;
        font-size: clamp(1.35rem, 3vw, 2rem);
        font-style: italic;
        letter-spacing: .05em;
      }
      .stage-select-heading p { margin: 0; color: var(--muted); font-size: .83rem; font-weight: 800; }
      .stage-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 13px;
      }
      .stage-card {
        position: relative;
        display: grid;
        grid-template-rows: 132px auto auto auto;
        min-width: 0;
        overflow: hidden;
        padding: 10px 9px 11px;
        border: 1px solid rgba(119, 197, 255, .55);
        border-radius: 16px;
        color: var(--ink);
        background: linear-gradient(145deg, rgba(27, 42, 94, .96), rgba(7, 13, 39, .98));
        box-shadow: 0 9px 0 #060b22, 0 13px 22px rgba(0,0,0,.24);
        cursor: pointer;
        isolation: isolate;
        transition: transform .18s ease, border-color .18s ease, filter .18s ease;
      }
      .stage-card::before {
        position: absolute;
        z-index: -1;
        inset: auto -12% -34% 30%;
        height: 65%;
        content: "";
        border-radius: 50%;
        background: radial-gradient(circle, rgba(32,226,255,.27), transparent 69%);
      }
      .stage-card:hover { border-color: var(--gold); transform: translateY(-5px); }
      .stage-card:active { transform: translateY(2px); box-shadow: 0 4px 0 #060b22; }
      .stage-card-monster { display: grid; min-width: 0; place-items: end center; }
      .stage-card-monster img {
        width: 100%;
        height: 130px;
        object-fit: contain;
