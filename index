            return new Set();
          }
        })();

        const randomInt = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;
        const shuffle = values => {
          const shuffled = [...values];
          for (let index = shuffled.length - 1; index > 0; index -= 1) {
            const swapIndex = randomInt(0, index);
            [shuffled[index], shuffled[swapIndex]] = [shuffled[swapIndex], shuffled[index]];
          }
          return shuffled;
        };

        function buildQuestionDeck() {
          return shuffle(FACTORS.flatMap(factor => Array(QUESTIONS_PER_FACTOR).fill(factor)));
        }

        function setStageContent() {
          els.playerName.textContent = activeStage.playerName;
          els.enemyName.textContent = activeStage.enemyName;
          els.stageVs.textContent = activeStage.vsLabel;
          els.startTitle.innerHTML = `STAGE ${activeStage.number}<br />${activeStage.tableLabel}`;
          els.startDescription.innerHTML = `${activeStage.tableLabel}を全18問！ 1〜9を2回ずつランダムに出題。<br />10秒以内に二択を選ぼう。正解ならパンチ、時間切れなら反撃だ！`;
          els.stageRule.innerHTML = `<span class="rule-dot">●</span> ステージ${activeStage.number}・${activeStage.tableLabel}：1〜9を2回ずつランダム出題`;
        }

        function refreshStageCards() {
          els.stageCards.forEach(card => {
            const stageNumber = Number(card.dataset.stageSelect);
            const stage = STAGES[stageNumber];
            const cleared = clearedStages.has(stageNumber);
            const monsterImage = card.querySelector('img');
            const status = card.querySelector('.stage-card-status');
            monsterImage.src = cleared ? stage.sprites.monsterDefeat : stage.sprites.monster;
            status.textContent = cleared ? 'CLEARED!' : 'CHALLENGE';
            card.classList.toggle('is-cleared', cleared);
          });
        }

        function rememberClear(stageNumber) {
          clearedStages.add(stageNumber);
          try {
            localStorage.setItem(CLEAR_RECORD_KEY, JSON.stringify([...clearedStages]));
          } catch {
            // The title screen remains updated even when browser storage is unavailable.
          }
          refreshStageCards();
        }

        function showTitleScreen() {
          els.gameShell.hidden = true;
          els.titleScreen.hidden = false;
          refreshStageCards();
        }

        function startFromTitle(stageNumber) {
          els.titleScreen.hidden = true;
          els.gameShell.hidden = false;
          startMatch(stageNumber);
        }

        function updateSoundToggle() {
          const enabled = audio.enabled;
          els.soundToggle.setAttribute('aria-pressed', String(enabled));
          els.soundToggle.setAttribute('aria-label', enabled ? '音声をオフにする' : '音声をオンにする');
          els.soundToggleLabel.textContent = enabled ? '音 ON' : '音 OFF';
        }

        async function toggleSound() {
          try {
            const enabled = await audio.setEnabled(!audio.enabled);
            updateSoundToggle();
            if (enabled) audio.playSelect();
          } catch {
            await audio.setEnabled(false);
            updateSoundToggle();
          }
        }

        function updateHealth() {
          const playerPercent = (state.playerHp / MAX_PLAYER_HP) * 100;
          const enemyPercent = (state.enemyHp / MAX_ENEMY_HP) * 100;
          els.playerHealth.style.width = `${playerPercent}%`;
          els.enemyHealth.style.width = `${enemyPercent}%`;
          els.playerHpText.textContent = state.playerHp;
          els.enemyHpText.textContent = state.enemyHp;
          els.round.textContent = `STAGE ${activeStage.number}　${activeStage.tableLabel} ${state.asked} / ${TOTAL_QUESTIONS}`;
        }

        function removeEffects() {
          els.arena.classList.remove('attack', 'damage');
        }

        function resetSprites() {
          els.playerSprite.src = activeStage.sprites.player;
          els.monsterSprite.src = activeStage.sprites.monster;
        }

        function setResultSprites(cleared) {
          if (cleared) {
            els.playerSprite.src = activeStage.sprites.playerVictory;
            els.monsterSprite.src = activeStage.sprites.monsterDefeat;
          } else {
            els.playerSprite.src = activeStage.sprites.playerDefeat;
          }
        }

        function stopClock() {
          clearTimeout(state.timeoutId);
          cancelAnimationFrame(state.frameId);
          state.timeoutId = null;
          state.frameId = null;
        }

        function setButtonsDisabled(disabled) {
          els.answers.forEach(button => { button.disabled = disabled; });
        }

        function newQuestion() {
          removeEffects();
          const right = questionDeck.shift();
          state.asked += 1;
          state.answer = activeStage.tableFactor * right;
          updateHealth();
          let wrong = state.answer + randomInt(-10, 10);
          while (wrong === state.answer || wrong < 1) wrong = state.answer + randomInt(1, 9);
          const options = shuffle([state.answer, wrong]);
          els.question.textContent = `${activeStage.tableFactor} × ${right}`;
          els.answers.forEach((button, index) => {
            button.querySelector('span:last-child').textContent = options[index];
            button.dataset.value = options[index];
          });
          els.copy.textContent = `${activeStage.tableLabel}！ 迷っている時間はない。答えを選べ！`;
          setButtonsDisabled(false);
          state.active = true;
          startClock();
        }

        function startClock() {
          state.startedAt = performance.now();
          els.timerFill.classList.remove('rush');
          const tick = now => {
            const elapsed = now - state.startedAt;
            const remain = Math.max(0, ROUND_TIME - elapsed);
            const ratio = remain / ROUND_TIME;
            els.timerFill.style.width = `${ratio * 100}%`;
            els.timerReadout.textContent = (remain / 1000).toFixed(2);
            if (ratio < .35) els.timerFill.classList.add('rush');
            if (remain > 0 && state.active) state.frameId = requestAnimationFrame(tick);
          };
          state.frameId = requestAnimationFrame(tick);
          state.timeoutId = setTimeout(() => resolve(false, true), ROUND_TIME);
        }

        function resolve(isCorrect, timedOut = false) {
          if (!state.active) return;
          state.active = false;
          stopClock();
          setButtonsDisabled(true);
          if (isCorrect) {
            audio.playCorrect();
            state.correct += 1;
            state.enemyHp = Math.max(0, state.enemyHp - 1);
            els.impact.textContent = 'PUNCH!';
            els.arena.classList.add('attack');
            els.copy.textContent = '正解！ クリティカル・パンチ！';
          } else {
            audio.playDamage();
            state.playerHp = Math.max(0, state.playerHp - 1);
            els.impact.textContent = timedOut ? 'TIME UP!' : 'COUNTER!';
            els.arena.classList.add('damage');
            els.copy.textContent = timedOut ? '時間切れ！ モンスターのアタックを受けた！' : 'おしい！ モンスターのカウンターアタックを受けた！';
          }
          updateHealth();
          const finished = state.playerHp === 0 || questionDeck.length === 0;
          if (finished) {
            setTimeout(endMatch, 900);
          } else {
            setTimeout(newQuestion, 830);
          }
        }

        function endMatch() {
          const cleared = state.playerHp > 0 && state.asked === TOTAL_QUESTIONS;
          els.arena.classList.add('ko');
          els.arena.classList.add(cleared ? 'player-wins' : 'player-loses');
          setResultSprites(cleared);
          els.impact.textContent = 'K.O.!';
          if (cleared) {
            audio.playClear();
            rememberClear(activeStage.number);
          }
          if (cleared && activeStage.number < 8) {
            const nextStage = STAGES[activeStage.number + 1];
            els.resultTitle.textContent = `STAGE ${activeStage.number} CLEAR!`;
            els.resultText.textContent = `${state.correct} / ${TOTAL_QUESTIONS}問 正解！ ${nextStage.tableLabel}のステージ${nextStage.number}にチャレンジする？`;
            els.nextStageButton.hidden = false;
            els.nextStageButton.textContent = `STAGE ${nextStage.number}へ！`;
            els.restartButton.textContent = `STAGE ${activeStage.number}をもう一度`;
          } else {
            els.resultTitle.textContent = cleared ? 'STAGE 8 COMPLETE!' : 'YOU LOSE';
            els.resultText.textContent = cleared
              ? `${state.correct} / ${TOTAL_QUESTIONS}問 正解！ 9の段を2回ずつクリア！ 全ステージ制覇！`
              : `正解は${state.correct} / ${TOTAL_QUESTIONS}問。もう一度${activeStage.tableLabel}に挑戦しよう！`;
            els.nextStageButton.hidden = true;
            els.restartButton.textContent = `STAGE ${activeStage.number}をもう一度`;
          }
          els.startPanel.style.display = 'none';
          els.resultPanel.classList.add('show');
          els.titleButton.hidden = false;
          els.startLayer.classList.remove('hidden');
        }

        function startMatch(stageNumber = 1) {
          stopClock();
          activeStage = STAGES[stageNumber];
          questionDeck = buildQuestionDeck();
          state = { stage: activeStage.number, playerHp: MAX_PLAYER_HP, enemyHp: MAX_ENEMY_HP, correct: 0, asked: 0, active: false, answer: 0, startedAt: 0, timeoutId: null, frameId: null };
          els.arena.classList.remove('ko', 'attack', 'damage', 'player-wins', 'player-loses');
          setStageContent();
          resetSprites();
          els.startPanel.style.display = '';
          els.resultPanel.classList.remove('show');
          els.nextStageButton.hidden = true;
          els.titleButton.hidden = true;
          els.startLayer.classList.add('hidden');
          updateHealth();
          newQuestion();
        }

        els.answers.forEach(button => {
          button.addEventListener('click', () => resolve(Number(button.dataset.value) === state.answer));
        });
        document.addEventListener('keydown', event => {
          if (!state.active || event.repeat) return;
          if (event.key === '1' || event.key === '2') {
            event.preventDefault();
            els.answers[Number(event.key) - 1].click();
          }
        });
        els.startButton.addEventListener('click', () => {
          audio.playSelect();
          startMatch(1);
        });
        els.restartButton.addEventListener('click', () => {
          audio.playSelect();
          startMatch(state.stage);
        });
        els.nextStageButton.addEventListener('click', () => {
          audio.playSelect();
          startMatch(state.stage + 1);
        });
        els.titleButton.addEventListener('click', () => {
          audio.playSelect();
          showTitleScreen();
        });
        els.soundToggle.addEventListener('click', toggleSound);
        els.stageCards.forEach(card => {
          card.addEventListener('click', () => {
            audio.playSelect();
            startFromTitle(Number(card.dataset.stageSelect));
          });
        });
        setStageContent();
        updateHealth();
        refreshStageCards();
        updateSoundToggle();
      })();
    </script>
  </body>
</html>
